// Experimental Worker only. Replace placeholders in a separate authenticated workspace.
// Do not enable R2 or point this at the Production candidate database.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blind-face-select-invite-sample",
  "main": "invite-sample-worker.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./invite-sample-assets",
    "run_worker_first": ["/v1/*"]
  },
  "d1_databases": [
    { "binding": "INVITE_DB", "database_name": "blind-face-select-invite-sample", "database_id": "REPLACE_WITH_DEDICATED_D1_ID" }
  ],
  "vars": { "APP_ORIGIN": "https://REPLACE_WITH_SAMPLE_WORKER_HOST" },
  "secrets": { "required": ["ADMIN_SECRET"] }
}
